{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "thumbnail": {
      "additionalProperties": true,
      "title": "Thumbnail",
      "type": "object"
    },
    "script_sha256": {
      "default": "",
      "pattern": "^([0-9a-f]{64})?$",
      "title": "Script Sha256",
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "title": "MetadataArtifact",
  "type": "object"
}
