{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnchoredSFX": {
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "scene_frame": {
          "minimum": 0,
          "title": "Scene Frame",
          "type": "integer"
        },
        "absolute_frame": {
          "minimum": 0,
          "title": "Absolute Frame",
          "type": "integer"
        },
        "volume": {
          "maximum": 1,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "scene_id",
        "scene_frame",
        "absolute_frame",
        "volume"
      ],
      "title": "AnchoredSFX",
      "type": "object"
    },
    "AudioMixArtifact": {
      "properties": {
        "input_narration_path": {
          "title": "Input Narration Path",
          "type": "string"
        },
        "input_narration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Narration Sha256",
          "type": "string"
        },
        "assets_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assets Sha256",
          "type": "string"
        },
        "source_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Manifest Sha256"
        },
        "output_path": {
          "title": "Output Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "target_lufs": {
          "const": -16,
          "default": -16,
          "title": "Target Lufs",
          "type": "integer"
        },
        "integrated_lufs": {
          "title": "Integrated Lufs",
          "type": "number"
        },
        "true_peak_dbtp": {
          "maximum": -1,
          "title": "True Peak Dbtp",
          "type": "number"
        },
        "ducking": {
          "enum": [
            "sidechaincompress",
            "not-applicable"
          ],
          "title": "Ducking",
          "type": "string"
        },
        "sfx": {
          "items": {
            "$ref": "#/$defs/AnchoredSFX"
          },
          "title": "Sfx",
          "type": "array"
        },
        "filter_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Filter Sha256",
          "type": "string"
        }
      },
      "required": [
        "input_narration_path",
        "input_narration_sha256",
        "assets_sha256",
        "output_path",
        "sha256",
        "duration_ms",
        "integrated_lufs",
        "true_peak_dbtp",
        "ducking",
        "filter_sha256"
      ],
      "title": "AudioMixArtifact",
      "type": "object"
    },
    "AudioSegment": {
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "raw_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Raw Duration Ms",
          "type": "number"
        },
        "duration_frames": {
          "minimum": 30,
          "title": "Duration Frames",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "path",
        "raw_duration_ms",
        "duration_frames",
        "sha256"
      ],
      "title": "AudioSegment",
      "type": "object"
    },
    "SubtitleCue": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "startMs": {
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "endMs": {
          "minimum": 0,
          "title": "Endms",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "startMs",
        "endMs"
      ],
      "title": "SubtitleCue",
      "type": "object"
    }
  },
  "properties": {
    "assets_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assets Sha256"
    },
    "mix": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioMixArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "engine": {
      "const": "edge-tts",
      "default": "edge-tts",
      "title": "Engine",
      "type": "string"
    },
    "voice": {
      "title": "Voice",
      "type": "string"
    },
    "rate": {
      "title": "Rate",
      "type": "string"
    },
    "narration_path": {
      "title": "Narration Path",
      "type": "string"
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "title": "Duration Ms",
      "type": "number"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "script_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Script Sha256",
      "type": "string"
    },
    "storyboard_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Storyboard Sha256",
      "type": "string"
    },
    "fps": {
      "exclusiveMinimum": 0,
      "title": "Fps",
      "type": "integer"
    },
    "total_frames": {
      "exclusiveMinimum": 0,
      "title": "Total Frames",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/AudioSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "cues": {
      "items": {
        "$ref": "#/$defs/SubtitleCue"
      },
      "minItems": 1,
      "title": "Cues",
      "type": "array"
    },
    "timing_source": {
      "const": "edge-tts-word-boundaries+ffprobe",
      "default": "edge-tts-word-boundaries+ffprobe",
      "title": "Timing Source",
      "type": "string"
    }
  },
  "required": [
    "voice",
    "rate",
    "narration_path",
    "duration_ms",
    "sha256",
    "script_sha256",
    "storyboard_sha256",
    "fps",
    "total_frames",
    "segments",
    "cues"
  ],
  "title": "AudioArtifact",
  "type": "object"
}
