{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FactualSection": {
      "properties": {
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "unsupported_claims": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Claims",
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "pass"
      ],
      "title": "FactualSection",
      "type": "object"
    },
    "ReviewSection": {
      "properties": {
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "pass"
      ],
      "title": "ReviewSection",
      "type": "object"
    }
  },
  "properties": {
    "inputs_sha256": {
      "default": "",
      "pattern": "^([0-9a-f]{64})?$",
      "title": "Inputs Sha256",
      "type": "string"
    },
    "technical": {
      "$ref": "#/$defs/ReviewSection"
    },
    "editorial": {
      "$ref": "#/$defs/ReviewSection"
    },
    "factual": {
      "$ref": "#/$defs/FactualSection"
    },
    "overall": {
      "default": "",
      "pattern": "^(pass|warn|fail)?$",
      "title": "Overall",
      "type": "string"
    }
  },
  "required": [
    "technical",
    "editorial",
    "factual"
  ],
  "title": "DraftQualityArtifact",
  "type": "object"
}
