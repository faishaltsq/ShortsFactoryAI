{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EditorialCheck": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pass": {
          "title": "Pass",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "pass"
      ],
      "title": "EditorialCheck",
      "type": "object"
    }
  },
  "properties": {
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/EditorialCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "requires_operator_approval": {
      "const": true,
      "default": true,
      "title": "Requires Operator Approval",
      "type": "boolean"
    },
    "checked_at": {
      "default": "",
      "title": "Checked At",
      "type": "string"
    },
    "inputs_sha256": {
      "default": "",
      "pattern": "^([0-9a-f]{64})?$",
      "title": "Inputs Sha256",
      "type": "string"
    }
  },
  "required": [
    "eligible"
  ],
  "title": "ApprovalArtifact",
  "type": "object"
}
