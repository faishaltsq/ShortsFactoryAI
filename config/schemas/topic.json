{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Genre": {
      "enum": [
        "educational",
        "science",
        "history",
        "mystery",
        "fiction",
        "general_knowledge",
        "animated_narrative"
      ],
      "title": "Genre",
      "type": "string"
    },
    "SelectionScores": {
      "properties": {
        "originality": {
          "maximum": 10,
          "minimum": 0,
          "title": "Originality",
          "type": "integer"
        },
        "hook": {
          "maximum": 10,
          "minimum": 0,
          "title": "Hook",
          "type": "integer"
        },
        "verifiability": {
          "maximum": 10,
          "minimum": 0,
          "title": "Verifiability",
          "type": "integer"
        },
        "visual": {
          "maximum": 10,
          "minimum": 0,
          "title": "Visual",
          "type": "integer"
        },
        "genre_diversity": {
          "maximum": 10,
          "minimum": 0,
          "title": "Genre Diversity",
          "type": "integer"
        }
      },
      "required": [
        "originality",
        "hook",
        "verifiability",
        "visual",
        "genre_diversity"
      ],
      "title": "SelectionScores",
      "type": "object"
    },
    "SourceRef": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "published": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published"
        },
        "accessed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessed"
        }
      },
      "required": [
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TopicCandidate": {
      "properties": {
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "genre": {
          "$ref": "#/$defs/Genre"
        },
        "hook": {
          "title": "Hook",
          "type": "string"
        },
        "angle": {
          "title": "Angle",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "verification": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "needs_review"
        },
        "visual_potential": {
          "default": 5,
          "maximum": 10,
          "minimum": 0,
          "title": "Visual Potential",
          "type": "integer"
        },
        "novelty": {
          "default": 5,
          "maximum": 10,
          "minimum": 0,
          "title": "Novelty",
          "type": "integer"
        }
      },
      "required": [
        "topic_id",
        "title",
        "genre",
        "hook",
        "angle"
      ],
      "title": "TopicCandidate",
      "type": "object"
    },
    "TopicSelection": {
      "properties": {
        "selected_topic_id": {
          "title": "Selected Topic Id",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/SelectionScores"
        },
        "genre": {
          "$ref": "#/$defs/Genre"
        }
      },
      "required": [
        "selected_topic_id",
        "rationale",
        "scores",
        "genre"
      ],
      "title": "TopicSelection",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "supported",
        "needs_review",
        "unsupported",
        "fictional"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "properties": {
    "selection": {
      "$ref": "#/$defs/TopicSelection"
    },
    "topic": {
      "$ref": "#/$defs/TopicCandidate"
    }
  },
  "required": [
    "selection",
    "topic"
  ],
  "title": "TopicArtifact",
  "type": "object"
}
