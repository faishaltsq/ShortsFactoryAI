{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "mode": {
      "const": "project-generated-vectors",
      "default": "project-generated-vectors",
      "title": "Mode",
      "type": "string"
    },
    "templates": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Templates",
      "type": "array"
    },
    "assets": {
      "items": {
        "type": "string"
      },
      "title": "Assets",
      "type": "array"
    },
    "license": {
      "const": "project-original",
      "default": "project-original",
      "title": "License",
      "type": "string"
    }
  },
  "required": [
    "templates"
  ],
  "title": "AssetManifest",
  "type": "object"
}
