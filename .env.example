# ---- LLM providers ----
# DeepSeek-compatible OpenAI endpoint (local router or official API)
DEEPSEEK_BASE_URL=http://localhost:20128/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=tig/deepseek-v4.1-flash

# Strategic/editorial model uses the OpenAI-compatible HTTP endpoint below.

# Optional: direct OpenAI-compatible override
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ---- Orchestration ----
MAX_DAILY_TOKEN_BUDGET=400000
MAX_DAILY_COST_USD=2.00
MAX_RETRIES=5
# Content revisions per job when a draft fails review; exhaustion sets BLOCKED.
MAX_REPAIRS=2
# Failed runs before a job is blocked instead of retried.
MAX_JOB_ATTEMPTS=3
WORKER_CONCURRENCY=2

# ---- Production defaults ----
VIDEO_LANGUAGE=id-ID
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SEC=40
VIDEOS_PER_DAY=1
PLAN_DAYS=7

# ---- TTS ----
TTS_ENGINE=edge-tts
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%

# ---- YouTube (Phase 7) ----
# YOUTUBE_CLIENT_SECRET_JSON=config/client_secret.json
# YOUTUBE_PRIVATE_ONLY=true

# ---- Pixel Studio (opsional) ----
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8018
# STUDIO_API_ORIGIN=http://127.0.0.1:8018
# STUDIO_TOKEN=

# ---- Strategist (HTTP only; the CLI adapters were retired) ----
STRATEGIST_BASE_URL=http://localhost:20128/v1
STRATEGIST_MODEL=cx/gpt-6.1-sol
