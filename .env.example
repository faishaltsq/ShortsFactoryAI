# ---- LLM providers ----
# DeepSeek-compatible OpenAI endpoint (local router or official API)
DEEPSEEK_BASE_URL=http://localhost:20128/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=tig/deepseek-v4.1-flash

# Strategic/editorial model via CLI (non-interactive)
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=opus

# Fallback strategist through the locally authenticated Codex CLI
CODEX_CLI_BIN=codex
CODEX_CLI_MODEL=gpt-6.1-sol
CODEX_CLI_TIMEOUT_S=300
# Set to 0 to skip the Codex fallback entirely (e.g. while the CLI login is broken)
CODEX_CLI_ENABLED=1

# Optional: direct OpenAI-compatible override
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ---- Orchestration ----
MAX_DAILY_TOKEN_BUDGET=400000
MAX_DAILY_COST_USD=2.00
MAX_RETRIES=5
WORKER_CONCURRENCY=2

# ---- Production defaults ----
VIDEO_LANGUAGE=id-ID
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SEC=40
VIDEOS_PER_DAY=1
PLAN_DAYS=7

# ---- TTS ----
TTS_ENGINE=edge-tts
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%

# ---- YouTube (Phase 7) ----
# YOUTUBE_CLIENT_SECRET_JSON=config/client_secret.json
# YOUTUBE_PRIVATE_ONLY=true
